<mxPoint x="1630" y="515"/></Array></mxGeometry></mxCell><mxCell id="sys-50" value="Legend" style="rounded=1;whiteSpace=wrap;html=1;arcSize=2;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=13;dashed=1;fillColor=none;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="20" y="730" width="260" height="270" as="geometry"/></mxCell><mxCell id="sys-51" value="&lt;b&gt;→ solid&lt;/b&gt;: writes / traffic&lt;br&gt;&lt;b&gt;⇢ dashed&lt;/b&gt;: watches, reads, status&lt;br&gt;&lt;br&gt;&lt;span style='background:#dae8fc'&gt;&amp;nbsp;blue&amp;nbsp;&lt;/span&gt; operator &amp;amp; its API&lt;br&gt;&lt;span style='background:#ffe6cc'&gt;&amp;nbsp;orange&amp;nbsp;&lt;/span&gt; Envoy Gateway / Gateway API&lt;br&gt;&lt;span style='background:#d5e8d4'&gt;&amp;nbsp;green&amp;nbsp;&lt;/span&gt; tools &amp;amp; fixtures&lt;br&gt;&lt;span style='background:#fff2cc'&gt;&amp;nbsp;yellow&amp;nbsp;&lt;/span&gt; the OpenAPI document&lt;br&gt;&lt;span style='background:#e1d5e7'&gt;&amp;nbsp;purple&amp;nbsp;&lt;/span&gt; GCP&lt;br&gt;&lt;br&gt;Docs: ENVOY.md,&lt;br&gt;src/openapi-route-operator/DEVELOPING.md" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="35" y="760" width="235" height="230" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="ops" name="Operator internals"><mxGraphModel dx="1600" dy="990" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="990" math="0" shadow="0" background="#ffffff"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="ops-1" value="&lt;b style='font-size:18px'&gt;Operator internals — reconcile loop and compiler pipeline&lt;/b&gt;&lt;br&gt;internal/controller (Kubernetes I/O, status) calls internal/compiler (pure: bytes + bindings → plan or typed error)." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1500" height="40" as="geometry"/></mxCell><mxCell id="ops-2" value="Watches → work queue" style="rounded=1;whiteSpace=wrap;html=1;arcSize=2;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=13;dashed=1;fillColor=none;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="20" y="70" width="300" height="470" as="geometry"/></mxCell><mxCell id="ops-3" value="&lt;b&gt;For(OpenAPIRoute)&lt;/b&gt;&lt;br&gt;GenerationChanged: own status writes ignored" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="35" y="105" width="270" height="55" as="geometry"/></mxCell><mxCell id="ops-4" value="&lt;b&gt;Watches(HTTPRoute)&lt;/b&gt; → same-name OpenAPIRoute&lt;br&gt;drift, deletion, Envoy status, conflicts" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="35" y="175" width="270" height="55" as="geometry"/></mxCell><mxCell id="ops-5" value="&lt;b&gt;Watches(ConfigMap)&lt;/b&gt; via index documentRef.name" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="35" y="245" width="270" height="45" as="geometry"/></mxCell><mxCell id="ops-6" value="&lt;b&gt;Watches(Service)&lt;/b&gt; via index backendServices" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="35" y="305" width="270" height="45" as="geometry"/></mxCell><mxCell id="ops-7" value="&lt;b&gt;Watches(Gateway)&lt;/b&gt; via index parentGateways" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="35" y="365" width="270" height="45" as="geometry"/></mxCell><mxCell id="ops-8" value="&lt;b&gt;work queue&lt;/b&gt; → Reconcile(ns/name)&lt;br&gt;cache scoped to flights-lab&lt;br&gt;1 worker · leader election (Lease)&lt;br&gt;errors → requeue with backoff" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="35" y="430" width="270" height="95" as="geometry"/></mxCell><mxCell id="ops-9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;dashed=1;strokeColor=#999999;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="ops-3" target="ops-8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ops-10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;dashed=1;strokeColor=#999999;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="ops-4" target="ops-8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ops-11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;dashed=1;strokeColor=#999999;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="ops-5" target="ops-8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ops-12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;dashed=1;strokeColor=#999999;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="ops-6" target="ops-8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ops-13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;dashed=1;strokeColor=#999999;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="ops-7" target="ops-8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ops-14" value="Reconcile (internal/controller/openapiroute_controller.go)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=2;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=13;dashed=1;fillColor=none;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="350" y="70" width="560" height="900" as="geometry"/></mxCell><mxCell id="ops-15" value="&lt;b&gt;1.&lt;/b&gt; Get OpenAPIRoute &lt;b&gt;uncached&lt;/b&gt; (APIReader) · gone → done (route GC via ownerRef)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="370" y="105" width="520" height="45" as="geometry"/></mxCell><mxCell id="ops-16" value="&lt;b&gt;2. compile()&lt;/b&gt; read ConfigMap[documentRef.key] → &lt;b&gt;sourceDigest&lt;/b&gt;&lt;br&gt;compiler.Compile(doc, bindings, limits) → &lt;b&gt;SourceValid&lt;/b&gt;&lt;br&gt;missing CM/key or compile error → plan = nil (error Kind is the reason)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="370" y="170" width="520" height="70" as="geometry"/></mxCell><mxCell id="ops-17" value="&lt;b&gt;3.&lt;/b&gt; Get HTTPRoute at the OpenAPIRoute's name; owned = controller ownerRef is this OpenAPIRoute" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="370" y="260" width="520" height="45" as="geometry"/></mxCell><mxCell id="ops-18" value="exists and &lt;b&gt;not owned&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="370" y="325" width="250" height="60" as="geometry"/></mxCell><mxCell id="ops-19" value="&lt;b&gt;plan == nil&lt;/b&gt; (invalid source)" style="rhombus;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="370" y="405" width="250" height="60" as="geometry"/></mxCell><mxCell id="ops-20" value="&lt;b&gt;plan empty&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="370" y="485" width="250" height="60" as="geometry"/></mxCell><mxCell id="ops-21" value="RouteApplied=False &lt;b&gt;NameConflict&lt;/b&gt;&lt;br&gt;never modify it" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="650" y="325" width="240" height="60" as="geometry"/></mxCell><mxCell id="ops-22" value="RouteApplied=False &lt;b&gt;NotApplied&lt;/b&gt;&lt;br&gt;keep existing route; create none" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="650" y="405" width="240" height="60" as="geometry"/></mxCell><mxCell id="ops-23" value="delete owned route&lt;br&gt;RouteApplied=True &lt;b&gt;NoOperations&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="650" y="485" width="240" height="60" as="geometry"/></mxCell><mxCell id="ops-24" value="&lt;b&gt;else: server-side apply&lt;/b&gt; desiredRoute(plan), force, field manager openapi-route-operator&lt;br&gt;unchanged plan = server no-op (no new resourceVersion)&lt;br&gt;RouteApplied=True &lt;b&gt;Applied&lt;/b&gt; · planDigest · routeName" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="370" y="570" width="520" height="70" as="geometry"/></mxCell><mxCell id="ops-25" value="&lt;b&gt;4. checkDependencies&lt;/b&gt;: every backend Service has the port; parent Gateways exist (same ns)&lt;br&gt;→ &lt;b&gt;DependenciesResolved&lt;/b&gt; (BackendNotFound / GatewayNotFound)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="370" y="665" width="520" height="50" as="geometry"/></mxCell><mxCell id="ops-26" value="&lt;b&gt;5. setReady&lt;/b&gt; (route &amp;amp; Gateway re-read &lt;b&gt;uncached&lt;/b&gt;): parents Accepted + ResolvedRefs&lt;br&gt;for the route's current generation, Gateway Programmed for its own → &lt;b&gt;Ready&lt;/b&gt;&lt;br&gt;else SourceInvalid · NameConflict · NoOperations · DependenciesMissing · Pending · …" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="370" y="735" width="520" height="70" as="geometry"/></mxCell><mxCell id="ops-27" value="&lt;b&gt;6.&lt;/b&gt; Events on SourceValid / RouteApplied transitions; Status().Update only if changed&lt;br&gt;Ready Pending / GatewayNotProgrammed → &lt;b&gt;RequeueAfter 5s&lt;/b&gt; (never wait on one event)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="370" y="825" width="520" height="55" as="geometry"/></mxCell><mxCell id="ops-28" value="Why uncached: on GKE the informer cache was seen missing status-subresource writes until a restart. Invalid input never changes an existing route. Removing a bound operation: edit the spec first (rejected as InvalidBinding, route kept), then drop the binding." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="370" y="890" width="520" height="70" as="geometry"/></mxCell><mxCell id="ops-29" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="ops-8" target="ops-15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ops-30" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="ops-15" target="ops-16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ops-31" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="ops-16" target="ops-17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ops-32" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;exitX=0.25;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="ops-17" target="ops-18"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ops-33" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="ops-18" target="ops-21"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ops-34" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="ops-18" target="ops-19"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ops-35" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="ops-19" target="ops-22"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ops-36" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="ops-19" target="ops-20"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ops-37" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="ops-20" target="ops-23"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ops-38" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.25;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="ops-20" target="ops-24"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ops-39" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;strokeColor=#999999;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="ops-21" target="ops-25"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ops-40" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;strokeColor=#999999;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="ops-22" target="ops-25"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ops-41" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;strokeColor=#999999;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="ops-23" target="ops-25"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ops-42" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="ops-24" target="ops-25"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ops-43" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="ops-25" target="ops-26"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ops-44" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="ops-26" target="ops-27"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ops-45" value="compiler.Compile (internal/compiler) — pure, no Kubernetes I/O" style="rounded=1;whiteSpace=wrap;html=1;arcSize=2;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=13;dashed=1;fillColor=none;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="940" y="70" width="640" height="900" as="geometry"/></mxCell><mxCell id="ops-46" value="&lt;b&gt;load.go&lt;/b&gt;&lt;br&gt;1. empty? · YAML/JSON → JSON tree&lt;br&gt;2. &lt;code&gt;openapi: 3.2.x&lt;/code&gt; required&lt;br&gt;3. official OAS 3.2 JSON Schema (embedded, 2026-08-30) — santhosh-tekuri/jsonschema&lt;br&gt;4. any &lt;code&gt;$ref&lt;/code&gt; not starting with # → UnsupportedRouting (nothing fetched)&lt;br&gt;5. libopenapi BuildV3Model (discard logger; any error = invalid, never use partial model)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="960" y="105" width="600" height="115" as="geometry"/></mxCell><mxCell id="ops-47" value="&lt;b&gt;extract.go&lt;/b&gt;&lt;br&gt;operations: GET…TRACE, &lt;b&gt;QUERY&lt;/b&gt;, &lt;b&gt;additionalOperations&lt;/b&gt; (kept so they can be rejected by name)&lt;br&gt;path params declared + required · operationId required &amp;amp; unique&lt;br&gt;webhooks + callbacks → &lt;b&gt;NotProjected&lt;/b&gt; (never routed)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="960" y="240" width="600" height="95" as="geometry"/></mxCell><mxCell id="ops-48" value="&lt;b&gt;match.go&lt;/b&gt; toMatch / compilePath&lt;br&gt;method must be HTTPRoute-routable; no path/op-level servers&lt;br&gt;literal path → &lt;b&gt;Exact&lt;/b&gt; · whole-segment {param} → &lt;b&gt;^…/[^/]+…$&lt;/b&gt; (QuoteMeta literals)&lt;br&gt;reject {id}.json, //, . / .., %2F, non-pchar, &amp;gt;1024 chars" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="960" y="355" width="600" height="95" as="geometry"/></mxCell><mxCell id="ops-49" value="&lt;b&gt;compile.go&lt;/b&gt; checkAmbiguity: two templates, same method, can match one request → reject&lt;br&gt;(Exact always beats regex in Envoy; regex-vs-regex order is not portable)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="960" y="470" width="600" height="70" as="geometry"/></mxCell><mxCell id="ops-50" value="&lt;b&gt;bind&lt;/b&gt;: operationBindings by operationId, else defaultBackendRef&lt;br&gt;binding for an unknown operationId → InvalidBinding" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="960" y="560" width="600" height="60" as="geometry"/></mxCell><mxCell id="ops-51" value="&lt;b&gt;group&lt;/b&gt;: sort (backend, Exact before regex, path, method); rules per backend, ≤64 matches each&lt;br&gt;≤16 rules, ≤128 matches (asserted against the vendored CRD) else CapacityExceeded&lt;br&gt;&lt;b&gt;digest&lt;/b&gt;: sha256 of methods/paths/backends only (descriptions, schemas, operationIds excluded)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="960" y="640" width="600" height="80" as="geometry"/></mxCell><mxCell id="ops-52" value="&lt;b&gt;Plan&lt;/b&gt;&lt;br&gt;Rules[] · NotProjected[] · Digest&lt;br&gt;empty plan = no route, never catch-all" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="960" y="740" width="290" height="70" as="geometry"/></mxCell><mxCell id="ops-53" value="&lt;b&gt;*Error{Kind, Problems[]}&lt;/b&gt;&lt;br&gt;all problems of the most fundamental Kind" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="1270" y="740" width="290" height="70" as="geometry"/></mxCell><mxCell id="ops-54" value="&lt;b&gt;Kind precedence&lt;/b&gt; (first non-empty wins; fixing an earlier kind can change later ones):&lt;br&gt;InvalidDocument → UnsupportedRouting → InvalidBinding → CapacityExceeded&lt;br&gt;&lt;br&gt;Tests: compiler unit tests (testing), controller envtest (Ginkgo, K8s 1.35), GKE acceptance (make test-e2e)." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="960" y="830" width="600" height="120" as="geometry"/></mxCell><mxCell id="ops-55" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="ops-46" target="ops-47"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ops-56" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="ops-47" target="ops-48"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ops-57" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="ops-48" target="ops-49"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ops-58" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="ops-49" target="ops-50"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ops-59" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="ops-50" target="ops-51"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ops-60" value="ok" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;exitX=0.25;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="ops-51" target="ops-52"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ops-61" value="problems" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;strokeColor=#b85450;exitX=0.75;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="ops-51" target="ops-53"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ops-62" value="Compile()" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="ops-16" target="ops-46"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>